# 이 파일을 복사해서 .env로 저장한 뒤 실제 값을 채우세요.
# .env는 .gitignore에 등록되어 있어 커밋되지 않습니다.

# --- Neo4j AuraDB ---
# 기존 두 인스턴스(e209da6f, 73e3e9d7)는 DNS 조회 실패로 확인됨 -> 삭제된 것으로 보임.
# https://console.neo4j.io 에서 새 인스턴스를 만들고 아래에 채워주세요.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Ollama (Supervisor 라우팅용 로컬 LLM) ---
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.1:8b

# --- Kaggle Image Agent (ngrok으로 노출된 FastAPI) ---
KAGGLE_API_URL=https://your-ngrok-url.ngrok-free.dev
# 노트북 FastAPI 서버와 반드시 동일한 값이어야 함 (X-API-Key 헤더 인증용)
KAGGLE_API_KEY=

# --- Agent 서버 포트 ---
KG_AGENT_URL=http://localhost:8001
REPORT_AGENT_URL=http://localhost:8002

# --- A2A ---
A2A_TIMEOUT=60

# --- Kaggle 노트북 전용 (로컬 config.py는 사용하지 않지만 참고용으로 함께 관리) ---
HF_TOKEN=
NGROK_AUTHTOKEN=
